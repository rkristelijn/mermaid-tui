# versions.env — single source of truth for development tool versions
#
# Read by: Makefile, scripts/dev/setup.sh, .github/workflows/ci.yml

# Build tools (C++20, g++)
GCC_VERSION=14
JQ_VERSION=1.7

# LLVM tools (clang-format, clang-tidy)
LLVM_VERSION=19

# Quality tools
CPPCHECK_VERSION=2.13
PMCCABE_VERSION=2.8
DOXYGEN_VERSION=1.16.1
SHELLCHECK_VERSION=0.10.0
CLOC_VERSION=2.02

# SAST tools
SEMGREP_VERSION=1.56.0
GITLEAKS_VERSION=8.18.2

# Linters
YAMLLINT_VERSION=1.33.0
RUMDL_VERSION=0.1.73

# Coverage (lcov/gcov/bc are system packages, not pinned)
