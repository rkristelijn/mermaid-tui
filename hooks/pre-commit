#!/bin/sh

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
    echo "ERROR: direct commits to main are not allowed. Use a feature branch."
    exit 1
fi

if [ ! -f mermaid-tui ] || [ src/main.c -nt mermaid-tui ]; then
    make -s || { echo "ERROR: build failed"; exit 1; }
fi

exit 0
